{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    
    // --- THE FIX ---
    "jsx": "preserve",                 // Let Vite handle the compilation
    "jsxImportSource": "solid-js",     // Tell TS to look at Solid for <div> types
    // ----------------
    
    "types": ["vite/client"],          // Helps TS understand import.meta.env
    "noEmit": true,                    // Vite does the building, TS just checks types
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}